import "dotenv/config";

// Force load envs
const url = process.env.DATABASE_URL;

if (!url) {
    throw new Error("DATABASE_URL is not defined");
}

export default {
    schema: "prisma/schema.prisma",
    migrations: {
        path: "prisma/migrations",
        seed: "npx tsx prisma/seed.ts",
    },
    datasource: {
        url,
    },
};
