# Base de Datos PostgreSQL
DATABASE_URL="postgresql://postgres:password@db:5432/coopetraes?schema=public"

# NextAuth / Autenticación
NEXTAUTH_SECRET="cambiar_por_un_string_aleatorio_seguro_de_32_caracteres"
NEXTAUTH_URL="http://localhost:3000"

# URL pública de la aplicación (usada para QR y enlaces FUEC)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Redis (Opcional, para caché distribuido y colas SIMIT)
REDIS_URL="redis://redis:6379"
CACHE_PROVIDER="REDIS"

# Almacenamiento local o S3 (LOCAL por defecto)
STORAGE_PROVIDER="LOCAL"
UPLOAD_DIR="/app/uploads"
STORAGE_PATH="/app/storage"

# Variables S3 (Solo si STORAGE_PROVIDER="S3")
# AWS_BUCKET_NAME=""
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Opciones de inicio
SEED_ON_START="false"
PORT=3000
NODE_ENV="production"
