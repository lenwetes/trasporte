# ==========================================
# Configuración de Base de Datos PostgreSQL
# ==========================================
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password_secure_2026"
POSTGRES_DB="coopetraes"

# Cadena de conexión para la aplicación (en la red interna de Docker)
DATABASE_URL="postgresql://postgres:postgres_password_secure_2026@postgres:5432/coopetraes?schema=public"

# ==========================================
# Caché y Colas con Redis
# ==========================================
REDIS_URL="redis://redis:6379"
CACHE_PROVIDER="REDIS"

# ==========================================
# Autenticación (NextAuth / Auth.js)
# ==========================================
# Generar una clave secreta segura con: openssl rand -base64 32
NEXTAUTH_SECRET="coopetraes_auth_secure_secret_production_2026_x89q"
AUTH_SECRET="coopetraes_auth_secure_secret_production_2026_x89q"
AUTH_TRUST_HOST="true"

# URL pública o dominio asignado en Coolify
NEXTAUTH_URL="https://app.coopetraes.com"
NEXT_PUBLIC_APP_URL="https://app.coopetraes.com"

# ==========================================
# Administrador Inicial (Creación Automática)
# ==========================================
ADMIN_EMAIL="admin@coopetraes.com"
ADMIN_PASSWORD="admin123"
ADMIN_NOMBRES="Administrador"
ADMIN_APELLIDOS="Sistema"

# ==========================================
# Almacenamiento de Archivos (LOCAL o S3)
# ==========================================
STORAGE_PROVIDER="LOCAL"
UPLOAD_DIR="/app/uploads"
STORAGE_PATH="/app/storage"

# Variables S3 (Opcional, solo si STORAGE_PROVIDER="S3")
# AWS_BUCKET_NAME=""
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# ==========================================
# Configuración de Ejecución y Servidor
# ==========================================
NODE_ENV="production"
PORT=3000
APP_PORT=3000
